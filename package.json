{
  "name": "vscode-google-java-format",
  "displayName": "Google Java Format for VSCode",
  "description": "Google Java Format for Visual Studio Code",
  "repository": {
    "url": "https://github.com/lantoolblog/vscode-google-java-format"
  },
  "publisher": "lantoolblog",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.105.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "Google Java Format Extension for VSCode",
        "properties": {
          "gjfe.executionType": {
            "type": "string",
            "enum": [
              "native",
              "jar"
            ],
            "default": "native",
            "description": "Choose whether to run the extension using a JAR file or a native executable."
          },
          "gjfe.nativeImagePath": {
            "title": "Native Image Path",
            "type": "string",
            "markdownDescription": "[Google Java Format's first native images released](https://github.com/google/google-java-format/releases/tag/v1.20.0)"
          },
          "gjfe.jarPath": {
            "title": "Fat Jar Path",
            "type": "string",
            "markdownDescription": "[google-java-format-<version>-all-deps.jar](https://github.com/google/google-java-format/releases) path"
          },
          "gjfe.javaHome": {
            "title": "Java Home Path",
            "type": "string",
            "markdownDescription": "JAVA_HOME path to run Jar"
          },
          "gjfe.jvmOptions": {
            "title": "Java JVM Options as a library",
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED",
              "--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED",
              "--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED",
              "--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED",
              "--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED",
              "--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED"
            ],
            "markdownDescription": "[JVM Options Link](https://github.com/google/google-java-format#as-a-library)"
          }
        }
      }
    ],
    "languages": [
      {
        "id": "java",
        "extensions": [
          "java"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "pnpm exec vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
